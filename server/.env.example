PORT=3000
DATABASE_URL=postgres://cashflow:cashflow@localhost:5433/cashflow?sslmode=disable
HIVE_URL=http://localhost:7004
HIVE_SECRET=dev
OIDC_PROVIDER=http://localhost:7003
OIDC_CLIENT_ID=client-id
OIDC_CLIENT_SECRET=client-secret
# Through the web dev server, so the session cookie is set on its origin.
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback
APP_SECRET_KEY=development-secret-key-change-me-in-production-0123456789
# S3 mock from compose.next.yaml (any credentials work).
S3_BUCKET_NAME=cashflow
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_ENDPOINT=http://localhost:9091
# Mock rfinger from dock (any key works).
RFINGER_API_URL=http://localhost:9003
RFINGER_API_KEY=dev
# Fake Fortnox (make dev-fortnox): connecting approves at once.
FORTNOX_CLIENT_ID=dev
FORTNOX_CLIENT_SECRET=dev
FORTNOX_API_URL=http://localhost:9004/3
FORTNOX_AUTH_URL=http://localhost:9004/oauth-v1
