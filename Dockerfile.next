# Cashflow 4: one static Go binary that embeds the built frontend.
# Replaces Dockerfile at cutover.

FROM oven/bun:1-alpine AS web
WORKDIR /src/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web ./
RUN bun run build

FROM golang:1.27-alpine AS server
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY server ./
COPY --from=web /src/web/dist/client ./internal/spa/dist
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /bin/cashflow .

FROM alpine:3
ARG UID=10001
RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -H -s /sbin/nologin -u "${UID}" cashflow
ENV TZ=Europe/Stockholm
USER cashflow
COPY --from=server /bin/cashflow /bin/cashflow
EXPOSE 3000
CMD ["/bin/cashflow"]
