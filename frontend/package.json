{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-bun": "^1.0.2",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3-scale": "^4.0.9",
		"@types/validator": "^13.15.10",
		"@vitest/ui": "4.1.7",
		"jsdom": "^29.1.1",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.0.12",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@embedpdf/core": "^2.15.1",
		"@embedpdf/engines": "^2.15.1",
		"@embedpdf/plugin-document-manager": "^2.15.1",
		"@embedpdf/plugin-interaction-manager": "^2.15.1",
		"@embedpdf/plugin-render": "^2.15.1",
		"@embedpdf/plugin-selection": "^2.15.1",
		"@embedpdf/svelte-pdf-viewer": "^2.15.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.76.0",
		"bits-ui": "^2.21.0",
		"d3-scale": "^4.0.3",
		"dinero.js": "^2.0.2",
		"ibantools": "^4.5.4",
		"layerchart": "^2.11.0",
		"pino": "^10.4.0",
