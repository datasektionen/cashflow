{
  "name": "cashflow-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "cd ../proto && buf generate",
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "build:server": "vite build && rm -rf ../server/internal/spa/dist/assets ../server/internal/spa/dist/*.* && cp -r dist/client/. ../server/internal/spa/dist/",
    "check": "biome check . && tsc --noEmit && vitest run",
    "fix": "biome check --write .",
    "test": "vitest",
    "ui:add": "./scripts/ui-add.sh"
  },
