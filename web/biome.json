{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "e2e/**",
      "e2e-demo/**",
      "playwright.demo.config.ts",
      "vite.config.ts",
      "playwright.config.ts",
      "!src/gen",
      "!src/routeTree.gen.ts",
      "!src/styles.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["e2e/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          },
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    }
  ]
}
